# .env.example — copy to .env.local for local development
#
# Production (Vercel): set the same keys in the project Environment Variables.
# See docs/production.md for Atlas + Vercel + saar.to setup.

# MongoDB — local install/Docker, or Atlas mongodb+srv://… for shared DB
MONGODB_URI=mongodb://127.0.0.1:27017/url-shortener

# Production env is not listed here. Pull it from Vercel into .env.prod:
#   npm run env:pull-prod

# Public origin used when building short links (use production domain even in local if you want saar.to URLs)
NEXT_PUBLIC_BASE_URL=https://saar.to

# NextAuth — must match the origin you open in the browser
# Local:  http://localhost:3000
# Prod:   https://saar.to
NEXTAUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Optional — owner vanity subdomains (resume.saar.to). Server-only.
# Create a Vercel token with domain scope; project/team from .vercel/project.json
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
